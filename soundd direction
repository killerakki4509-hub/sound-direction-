  <script>
    (function() {
      'use strict';

      // ---- DOM refs ----
      const freqDisplay = document.getElementById('freqDisplay');
      const freqReadout = document.getElementById('freqReadout');
      const freqSlider = document.getElementById('freqSlider');
      const dirDisplay = document.getElementById('dirDisplay');
      const needle = document.getElementById('needle');

      let currentFrequency = 440;

      // ---- direction names ----
      const dirNames = [
        'North', 'North-Northeast', 'Northeast', 'East-Northeast',
        'East', 'East-Southeast', 'Southeast', 'South-Southeast',
        'South', 'South-Southwest', 'Southwest', 'West-Southwest',
        'West', 'West-Northwest', 'Northwest', 'North-Northwest'
      ];

      // ---- map frequency → angle (0-360) ----
      function frequencyToAngle(freq) {
        const minF = 20, maxF = 2000;
        const t = (freq - minF) / (maxF - minF);
        // base rotation + a little organic curve
        const base = t * 360;
        const wobble = 10 * Math.sin(t * Math.PI * 2.5) + 5 * Math.cos(t * Math.PI * 4);
        let angle = (base + wobble) % 360;
        if (angle < 0) angle += 360;
        return angle;
      }

      // ---- update the whole UI ----
      function updateFromFrequency(freq) {
        // clamp + sync slider
        const clamped = Math.min(2000, Math.max(20, freq));
        currentFrequency = clamped;
        freqDisplay.textContent = Math.round(clamped);
        freqReadout.textContent = Math.round(clamped) + ' Hz';
        freqSlider.value = Math.round(clamped);

        // compute angle
        const angle = frequencyToAngle(clamped);

        // rotate needle
        needle.style.transform = `translateX(-50%) rotate(${angle}deg)`;

        // update direction text
        const idx = Math.round(angle / 22.5) % 16;
        dirDisplay.textContent = `${Math.round(angle)}° · ${dirNames[idx]}`;

        // highlight cardinal
        document.querySelectorAll('.cardinal').forEach(el => el.classList.remove('active'));
        const cardinalMap = {
          'North': 'N', 'North-Northeast': 'N', 'Northeast': 'E', 'East-Northeast': 'E',
          'East': 'E', 'East-Southeast': 'E', 'Southeast': 'S', 'South-Southeast': 'S',
          'South': 'S', 'South-Southwest': 'S', 'Southwest': 'W', 'West-Southwest': 'W',
          'West': 'W', 'West-Northwest': 'W', 'Northwest': 'N', 'North-Northwest': 'N'
        };
        const card = cardinalMap[dirNames[idx]] || 'N';
        const el = document.querySelector(`.cardinal[data-dir="${card}"]`);
        if (el) el.classList.add('active');
      }

      // ---- slider input ----
      freqSlider.addEventListener('input', function(e) {
        updateFromFrequency(Number(e.target.value));
      });

      // ---- subtle live drift for realism ----
      let driftPhase = 0;
      setInterval(function() {
        driftPhase += 0.028;
        const baseAngle = frequencyToAngle(currentFrequency);
        const drift = 2.2 * Math.sin(driftPhase * 2.3) + 1.3 * Math.cos(driftPhase * 1.7);
        let displayAngle = (baseAngle + drift) % 360;
        if (displayAngle < 0) displayAngle += 360;

        needle.style.transform = `translateX(-50%) rotate(${displayAngle}deg)`;
        const idx = Math.round(displayAngle / 22.5) % 16;
        dirDisplay.textContent = `${Math.round(displayAngle)}° · ${dirNames[idx]}`;

        document.querySelectorAll('.cardinal').forEach(el => el.classList.remove('active'));
        const cardinalMap = {
          'North': 'N', 'North-Northeast': 'N', 'Northeast': 'E', 'East-Northeast': 'E',
          'East': 'E', 'East-Southeast': 'E', 'Southeast': 'S', 'South-Southeast': 'S',
          'South': 'S', 'South-Southwest': 'S', 'Southwest': 'W', 'West-Southwest': 'W',
          'West': 'W', 'West-Northwest': 'W', 'Northwest': 'N', 'North-Northwest': 'N'
        };
        const card = cardinalMap[dirNames[idx]] || 'N';
        const el = document.querySelector(`.cardinal[data-dir="${card}"]`);
        if (el) el.classList.add('active');
      }, 170);

      // ---- FAQ accordion ----
      document.querySelectorAll('.faq-q').forEach(function(btn) {
        btn.addEventListener('click', function() {
          const item = this.parentElement;
          const isOpen = item.classList.contains('open');
          // close all
          document.querySelectorAll('.faq-item').forEach(function(i) {
            i.classList.remove('open');
          });
          // toggle current
          if (!isOpen) item.classList.add('open');
        });
      });

      // open first FAQ by default
      const firstFaq = document.querySelector('.faq-item');
      if (firstFaq) firstFaq.classList.add('open');

      // ---- smooth scroll for nav links ----
      document.querySelectorAll('a[href^="#"]').forEach(function(link) {
        link.addEventListener('click', function(e) {
          const target = document.querySelector(this.getAttribute('href'));
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });

      // ---- init ----
      updateFromFrequency(440);

    })();
  </script>

